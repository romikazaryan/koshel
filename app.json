{
  "expo": {
    "name": "koshel",
    "slug": "koshel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.koshel"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Разрешите доступ к микрофону для голосового ввода расходов.",
          "speechRecognitionPermission": "Разрешите распознавание речи для голосового ввода расходов."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#10B981"
        }
      ]
    ]
  }
}
